# ============================================
# Portfolio Configuration — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# All values here are injected at build time via Vite (VITE_ prefix required).
# Complex data uses JSON strings. Restart dev server after changes.

# ── Personal Info ──
VITE_NAME=Your Name
VITE_LOGO_INITIAL=Y
VITE_TITLE=Your Title
VITE_SUBTITLE=| Your Specialty

# ── Meta / SEO ──
VITE_META_TITLE=Your Name | Your Title
VITE_META_DESCRIPTION=Your Name - Your description for search engines.

# ── Social Links ──
VITE_GITHUB_URL=https://github.com/yourusername
VITE_LINKEDIN_URL=https://linkedin.com/in/yourusername
VITE_EMAIL=you@example.com
VITE_RESUME_URL=/resume.pdf

# ── Hero Section ──
VITE_HERO_BADGE=Open to Opportunities
VITE_HERO_DESCRIPTION=Your hero description with <strong>highlighted text</strong>.
VITE_CORE_STACK=["Tech1","Tech2","Tech3"]

# ── About Section ──
VITE_ABOUT_HEADING=The Engineer <highlight>Behind the Code</highlight>
VITE_ABOUT_SUBHEADING=Your about subheading.
VITE_ABOUT_P1=Your first about paragraph.
VITE_ABOUT_P2=Your second about paragraph.
VITE_ABOUT_P3=Your third about paragraph.
VITE_STATS=[{"label":"Years Experience","value":"1+","iconName":"briefcase"},{"label":"Projects Built","value":"5+","iconName":"code"}]
VITE_VALUES=["Value 1","Value 2","Value 3"]

# ── Contact Section ──
VITE_CONTACT_DESCRIPTION=Your contact section description.

# ── Footer ──
VITE_FOOTER_TAGLINE=Your footer tagline.

# ── Tech Stack — Also Familiar With ──
VITE_ALSO_FAMILIAR_WITH=["Tool1","Tool2","Tool3"]

# ── Projects (JSON array) ──
VITE_PROJECTS=[{"id":1,"title":"Project Name","description":"Description","highlights":["Highlight 1"],"tags":["Tag1"],"github":"https://github.com/you/project","live":null,"category":"Backend"}]

# ── Skills (JSON array) ──
VITE_SKILLS=[{"id":"backend","label":"Backend","color":"from-indigo-500 to-indigo-700","borderColor":"border-indigo-500/30","glowColor":"hover:shadow-indigo-500/20","skills":[{"name":"Skill","level":90}]}]

# ── Timeline (JSON array) ──
VITE_TIMELINE=[{"id":1,"year":"2024","title":"Title","subtitle":"Subtitle","description":"Description","tags":["Tag"],"icon":"🚀"}]
